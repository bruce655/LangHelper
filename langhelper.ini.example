[LangHelper]
; Provider for new windows: vscode (recommended), copilot-cli or auto.
; auto may use CLI if VS Code fails; the UI reports the fallback.
Provider=vscode

; VS Code model ID/family, or CLI model ID; also prefilled when selecting copilot-cli.
; Refresh models in the window to see the account's VS Code catalog.
; Sonnet 5.5 is requested explicitly: unavailable models report an error.
Model=claude-sonnet-5.5

; Feature blocks apply only to a modular prompt. Raw prompts ignore this.
Features=POLISH,BILINGUAL_EN_ZHTW

; Empty uses bundled prompt.md. A specified missing file is an error.
; Raw external prompts show "Features do not apply" in the UI.
PromptFile=

; Two clipboard updates within this interval, with Ctrl held, trigger translation.
DoubleCopyMs=700
MinChars=1
; Clipboard input exceeding this limit is truncated with a warning.
MaxChars=8000

; Translation timeout in seconds for either provider.
TimeoutSec=120

; 1 automatically copies only the main translation, never Notes.
; With multiple windows, the last completed successful translation wins.
AutoCopyResult=1
AlwaysOnTop=1

; 0 opens a new window per trigger; 1 reuses the most recent window.
SingleWindow=0
